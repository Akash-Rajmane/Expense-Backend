PORT=4000

# ClickHouse connection - Local (Port 8123 HTTP)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=expense_tracker

# ClickHouse connection - Cloud (Port 8443 HTTPS)
# CLICKHOUSE_URL=https://<your-service-id>.<region>.aws.clickhouse.cloud:8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=<your-password>
# CLICKHOUSE_DATABASE=expense_tracker

JWT_SECRET=your_jwt_secret_here

RZP_KEY_ID=your_razorpay_key_id
RZP_KEY_SECRET=your_razorpay_key_secret

BREVO_SMTP_KEY=your_brevo_smtp_key

# AWS S3 (Optional)
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=your_bucket_name

FE_HOST=http://localhost:3000
NODE_ENV=development
